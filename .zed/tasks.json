[
  {
    // 终端运行 Flutter；运行前按本次目标选择设备，多设备时可临时传入 -d <设备 ID>
    "label": "Flutter 模拟器启动 (debug)",
    "command": "flutter",
    "args": ["run", "-t", "lib/main.dart", "--debug"],
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    "reveal": "always"
  },
  {
    "label": "Flutter pub get",
    "command": "flutter",
    "args": ["pub", "get"],
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always"
  },
  {
    "label": "Flutter analyze",
    "command": "flutter",
    "args": ["analyze"],
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always"
  },
  {
    "label": "Flutter 构建 iOS (debug)",
    "command": "flutter",
    "args": ["build", "ios", "--debug"],
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    "reveal": "always"
  },
  {
    "label": "Flutter clean",
    "command": "flutter",
    "args": ["clean"],
    "use_new_terminal": false,
    "allow_concurrent_runs": false,
    "reveal": "always"
  },
  {
    // 已运行应用的 VM Service URI 会由 flutter run 输出；不要与 DTD URI 混用
    // 在 DevTools 页面手动输入 VM Service URI 后，使用 Debugger 设置断点、查看变量和单步
    "label": "Dart DevTools (Web)",
    "command": "dart",
    "args": ["devtools"],
    "use_new_terminal": true,
    "allow_concurrent_runs": true,
    "reveal": "always"
  },
  {
    // 连接已运行的应用；多设备或多实例时按本次目标指定设备或服务地址
    "label": "Flutter attach (已运行实例)",
    "command": "flutter",
    "args": ["attach"],
    "use_new_terminal": true,
    "allow_concurrent_runs": true,
    "reveal": "always"
  },
  {
    // Profile 用于性能分析，不是 Release；运行前确认目标设备支持该模式
    "label": "Flutter 模拟器启动 (profile)",
    "command": "flutter",
    "args": ["run", "-t", "lib/main.dart", "--profile"],
    "use_new_terminal": true,
    "allow_concurrent_runs": false,
    "reveal": "always"
  }
]
