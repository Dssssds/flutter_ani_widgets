{
  // ============================================================
  // Flutter X Widgets —— Zed 编辑器项目级设置
  // 由 .vscode/settings.json 迁移而来
  // 说明：原 VS Code 设置中的 cmake.* / java.* 属 VS Code 专用，
  //       Zed 无对应项，已移除；此处改为对 Flutter / Dart 真正有用的设置。
  // ============================================================

  // -------- 针对单个语言的编辑器行为 --------
  "languages": {
    "Dart": {
      // 保存时自动格式化（调用 dart LSP 提供的 dart format）
      "format_on_save": "on",
      // Dart 官方风格缩进为 2 个空格
      "tab_size": 2,
      // 软换行策略：达到首选行宽时自动换行
      "soft_wrap": "preferred_line_length",
      // 首选行宽，需与下方 LSP 的 lineLength 保持一致
      "preferred_line_length": 140,
    },
  },

  // -------- Dart 语言服务器(LSP)设置 --------
  // 默认只要 dart 在 PATH 中即可，无需额外配置；
  // 若使用 fvm，可把 binary.path 改为 fvm，并加 arguments，
  // 例如：
  //   "binary": { "path": "/opt/homebrew/bin/fvm",
  //               "arguments": ["dart", "language-server", "--protocol=lsp"] }
  "lsp": {
    "dart": {
      "settings": {
        // 放宽最大行宽，避免格式化时频繁断行（Dart 默认仅 80）
        "lineLength": 140,
        // 启用 LSP 的代码补全 / 跳转 / 重构等全部能力
        "enableSdkExtensionMethods": true,
      },
    },
  },

  // ============================================================
  // Zed 调试工作流
  // ============================================================
  // Zed 中的项目任务通过终端运行 Flutter CLI，不等同于 VS Code 的 Dart 调试会话。
  //
  //   1. 启动前确认本次目标设备，运行「Flutter 模拟器启动 (debug)」。
  //      如存在多个设备且 CLI 未提供选择提示，当次运行时传 -d <设备 ID>。
  //   2. 从 flutter run 输出复制 VM Service URI，运行「Dart DevTools (Web)」。
  //      在 DevTools 页面手动输入 URI 并连接；断点、变量与单步在 Debugger 中操作。
  //      DTD URI 不是 VM Service URI，无参数的 dart devtools 不会自动连接应用。
  //   3. flutter run 终端可按 r 热重载、R 热重启、q 退出。
  //
  // 已运行应用可用「Flutter attach (已运行实例)」连接；
  // 性能分析使用「Flutter 模拟器启动 (profile)」，不是 Release 模式。
  // ============================================================
}
